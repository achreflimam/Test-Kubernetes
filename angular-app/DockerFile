# Étape 1 : Construction
# Importez une image de base Node.js (version 16-alpine) pour construire l'application
FROM node:16-alpine AS build

# Définissez le dossier de travail
WORKDIR /app

# Copiez les fichiers package.json et package-lock.json
COPY package*.json ./

# Installez les dépendances NPM
RUN npm install

# Copiez tous les fichiers nécessaires localement vers l’image du conteneur
COPY . .
RUN npm run build --force

# Étape 2 : Exécution
# Importez une image de base Nginx (version 1.17.1-alpine) pour servir l'application
FROM nginx:1.17.1-alpine
COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=build /app/dist/angular-app /usr/share/nginx/html
